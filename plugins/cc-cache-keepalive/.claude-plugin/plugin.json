{
  "name": "cc-cache-keepalive",
  "version": "2.1.0",
  "description": "Keeps Claude Code's prompt cache warm on Max plans with a silent cron you arm per session. It cancels any tick that a recent real turn or an already-expired cache makes pointless.",
  "author": {
    "name": "Victor De Simone",
    "email": "victorsmoliveira@gmail.com",
    "url": "https://github.com/vdsmon"
  },
  "homepage": "https://github.com/vdsmon/skills",
  "repository": "https://github.com/vdsmon/skills",
  "license": "MIT",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/keepalive-guard.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/keepalive-sensor.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
